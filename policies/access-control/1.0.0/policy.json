{
  "policyId": "access-control",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes access requests using authentication, authorization, multi-factor authentication, device trust, and session risk evaluation.",

  "signalsSchema": {
    "userAuthenticated": "boolean",
    "userAuthorized": "boolean",
    "mfaVerified": "boolean",
    "deviceTrusted": "boolean",
    "sessionRiskScore": "number"
  },

  "rules": [
    {
      "id": "approve-access",
      "condition": {
        "all": [
          {
            "fact": "userAuthenticated",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "userAuthorized",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "mfaVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "deviceTrusted",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sessionRiskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Access authorized. Authentication, authorization, multi-factor authentication, device trust, and session risk requirements were satisfied."
      }
    },
    {
      "id": "reject-high-risk-session",
      "condition": {
        "fact": "sessionRiskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because the assessed session risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-untrusted-device",
      "condition": {
        "fact": "deviceTrusted",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because the requesting device is not trusted."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because one or more required authorization conditions were not satisfied."
      }
    }
  ]
}