{
  "policyId": "customer-refund",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes customer refunds after validating refund eligibility, approval, fraud assessment, and refund amount limits.",

  "signalsSchema": {
    "refundEligible": "boolean",
    "managerApproved": "boolean",
    "fraudCheckPassed": "boolean",
    "refundAmount": "number",
    "maximumRefundAmount": "number"
  },

  "rules": [
    {
      "id": "approve-refund",
      "condition": {
        "all": [
          {
            "fact": "refundEligible",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "managerApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "fraudCheckPassed",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "refundAmount",
            "operator": "lte",
            "value": 10000
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Refund authorized. Eligibility, approval, fraud assessment, and refund amount requirements were satisfied."
      }
    },
    {
      "id": "reject-excessive-refund",
      "condition": {
        "fact": "refundAmount",
        "operator": "gt",
        "value": 10000
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the requested refund amount exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-fraud-check",
      "condition": {
        "fact": "fraudCheckPassed",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the transaction did not pass fraud assessment."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}