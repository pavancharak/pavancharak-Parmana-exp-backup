{
  "policyId": "razorpay-refund",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes Razorpay refund creation after validating payment state, currency, refundable remainder, per-refund cap, and daily cumulative cap.",

  "signalsSchema": {
    "paymentStatus": "string",
    "paymentCurrency": "string",
    "refundableRemainingPaise": "number",
    "requestedRefundAmountPaise": "number",
    "requestedExceedsRemainder": "boolean",
    "dailyCumulativeAfterThisRefundPaise": "number"
  },

  "boundSignals": {
    "requestedRefundAmountPaise": "parameters.amountPaise"
  },

  "rules": [
    {
      "id": "reject-payment-not-captured",
      "condition": {
        "fact": "paymentStatus",
        "operator": "neq",
        "value": "captured"
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the payment status is not captured."
      }
    },
    {
      "id": "reject-currency-not-inr",
      "condition": {
        "fact": "paymentCurrency",
        "operator": "neq",
        "value": "INR"
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the payment currency is not INR."
      }
    },
    {
      "id": "reject-non-positive-amount",
      "condition": {
        "fact": "requestedRefundAmountPaise",
        "operator": "lte",
        "value": 0
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the requested refund amount is not positive."
      }
    },
    {
      "id": "reject-exceeds-refundable-remainder",
      "condition": {
        "fact": "requestedExceedsRemainder",
        "operator": "is_true"
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the requested amount exceeds the refundable remainder on the payment."
      }
    },
    {
      "id": "reject-exceeds-per-refund-cap",
      "condition": {
        "fact": "requestedRefundAmountPaise",
        "operator": "gt",
        "value": 500000
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the requested amount exceeds the per-refund cap of 500000 paise."
      }
    },
    {
      "id": "reject-exceeds-daily-cumulative-cap",
      "condition": {
        "fact": "dailyCumulativeAfterThisRefundPaise",
        "operator": "gt",
        "value": 2000000
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because it would exceed the daily cumulative cap of 2000000 paise."
      }
    },
    {
      "id": "approve-refund",
      "condition": {
        "all": [
          { "fact": "paymentStatus", "operator": "eq", "value": "captured" },
          { "fact": "paymentCurrency", "operator": "eq", "value": "INR" },
          { "fact": "requestedRefundAmountPaise", "operator": "gt", "value": 0 },
          { "fact": "requestedRefundAmountPaise", "operator": "lte", "value": 500000 },
          { "fact": "dailyCumulativeAfterThisRefundPaise", "operator": "lte", "value": 2000000 },
          { "fact": "requestedExceedsRemainder", "operator": "is_false" }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Refund authorized. Payment status, currency, refundable remainder, per-refund cap, and daily cumulative cap requirements were satisfied."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}
