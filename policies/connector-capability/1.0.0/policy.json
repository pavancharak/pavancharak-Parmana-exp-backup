{
  "policyId": "connector-capability",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Reference policy demonstrating capability-based authorization for Connector SDK connectors. Outcomes are strictly approve (ALLOW) or reject (BLOCK) — there is no approval-workflow, pending, or human-approval outcome.",

  "signalsSchema": {
    "capability": "string",
    "paymentAmount": "number"
  },

  "rules": [
    {
      "id": "allow-crm-read",
      "condition": {
        "fact": "capability",
        "operator": "eq",
        "value": "crm:read"
      },
      "outcome": {
        "action": "approve",
        "reason": "ALLOW: crm:read is authorized read-only CRM access."
      }
    },
    {
      "id": "allow-payments-refund-within-threshold",
      "condition": {
        "all": [
          {
            "fact": "capability",
            "operator": "eq",
            "value": "payments:refund"
          },
          {
            "fact": "paymentAmount",
            "operator": "lte",
            "value": 5000
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "ALLOW: payments:refund is authorized because the requested amount does not exceed the configured refund threshold of 5000."
      }
    },
    {
      "id": "block-crm-delete",
      "condition": {
        "fact": "capability",
        "operator": "eq",
        "value": "crm:delete"
      },
      "outcome": {
        "action": "reject",
        "reason": "BLOCK: crm:delete is never authorized by this reference policy."
      }
    },
    {
      "id": "block-payments-refund-above-threshold",
      "condition": {
        "all": [
          {
            "fact": "capability",
            "operator": "eq",
            "value": "payments:refund"
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 5000
          }
        ]
      },
      "outcome": {
        "action": "reject",
        "reason": "BLOCK: payments:refund is rejected because the requested amount exceeds the configured refund threshold of 5000."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "BLOCK: capability is not explicitly authorized by this reference policy."
      }
    }
  ]
}
