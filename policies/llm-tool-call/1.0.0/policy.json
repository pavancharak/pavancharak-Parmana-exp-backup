{
  "policyId": "llm-tool-call",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes AI-initiated tool execution after validating tool authorization, resource authorization, human approval, execution environment, and operational risk.",

  "signalsSchema": {
    "toolAllowed": "boolean",
    "resourceAuthorized": "boolean",
    "humanApproval": "boolean",
    "executionEnvironment": "string",
    "riskScore": "number"
  },

  "rules": [
    {
      "id": "approve-tool-call",
      "condition": {
        "all": [
          {
            "fact": "toolAllowed",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "resourceAuthorized",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "humanApproval",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "executionEnvironment",
            "operator": "eq",
            "value": "production"
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 25
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Tool execution authorized. Tool authorization, resource authorization, human approval, execution environment, and operational risk requirements were satisfied."
      }
    },
    {
      "id": "reject-high-risk-execution",
      "condition": {
        "fact": "riskScore",
        "operator": "gt",
        "value": 25
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because the assessed operational risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-unauthorized-tool",
      "condition": {
        "fact": "toolAllowed",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because the requested tool is not authorized."
      }
    },
    {
      "id": "reject-unauthorized-resource",
      "condition": {
        "fact": "resourceAuthorized",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because the requested resource is not authorized."
      }
    },
    {
      "id": "reject-missing-human-approval",
      "condition": {
        "fact": "humanApproval",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because the required human approval was not obtained."
      }
    },
    {
      "id": "reject-invalid-environment",
      "condition": {
        "fact": "executionEnvironment",
        "operator": "neq",
        "value": "production"
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because the execution environment is not authorized."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Tool execution rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}