{
  "policyId": "production-deployment",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes production deployments after validating deployment approval, successful verification, rollback readiness, maintenance window, and deployment risk assessment.",

  "signalsSchema": {
    "deploymentApproved": "boolean",
    "changeVerified": "boolean",
    "rollbackReady": "boolean",
    "maintenanceWindow": "boolean",
    "riskScore": "number"
  },

  "rules": [
    {
      "id": "approve-deployment",
      "condition": {
        "all": [
          {
            "fact": "deploymentApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "changeVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "rollbackReady",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "maintenanceWindow",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Production deployment authorized. Deployment approval, change verification, rollback readiness, maintenance window, and risk assessment requirements were satisfied."
      }
    },
    {
      "id": "reject-high-risk-deployment",
      "condition": {
        "fact": "riskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Production deployment rejected because the assessed deployment risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-unverified-change",
      "condition": {
        "fact": "changeVerified",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Production deployment rejected because the change has not been successfully verified."
      }
    },
    {
      "id": "reject-rollback-not-ready",
      "condition": {
        "fact": "rollbackReady",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Production deployment rejected because a validated rollback plan is not available."
      }
    },
    {
      "id": "reject-outside-maintenance-window",
      "condition": {
        "fact": "maintenanceWindow",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Production deployment rejected because execution is outside the approved maintenance window."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Production deployment rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}