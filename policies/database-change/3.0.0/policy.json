{
  "policyId": "database-change",
  "policyVersion": "3.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes production database changes after validating change approval, migration verification, backup availability, maintenance window, and operational risk.",

  "signalsSchema": {
    "changeApproved": "boolean",
    "migrationValidated": "boolean",
    "backupAvailable": "boolean",
    "maintenanceWindow": "boolean",
    "riskScore": "number"
  },

  "rules": [
    {
      "id": "approve-database-change",
      "condition": {
        "all": [
          {
            "fact": "changeApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "migrationValidated",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "backupAvailable",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "maintenanceWindow",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Database change authorized. Change approval, migration validation, backup availability, maintenance window, and operational risk requirements were satisfied."
      }
    },
    {
      "id": "reject-high-risk-change",
      "condition": {
        "fact": "riskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Database change rejected because the assessed operational risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-missing-backup",
      "condition": {
        "fact": "backupAvailable",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Database change rejected because a verified backup is not available."
      }
    },
    {
      "id": "reject-outside-maintenance-window",
      "condition": {
        "fact": "maintenanceWindow",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Database change rejected because execution is outside the approved maintenance window."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Database change rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}