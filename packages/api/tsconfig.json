{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "composite": true,

    "declaration": true,
    "declarationMap": true,

    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "tests",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],

"references": [
  { "path": "../shared" },
  { "path": "../storage" },
  { "path": "../runtime" },
  { "path": "../policy" },
  { "path": "../receipt" },
  { "path": "../replay" },
  { "path": "../execution-system" },
  { "path": "../envelope-verifier" }
]
}