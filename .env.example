###############################################################################
# Parmana — example environment file
#
# Copy to .env and fill in real values. Every variable below is read
# somewhere in packages/*/src (confirmed by grep for process.env.* against
# this session's audit — see docs/VERIFICATION-GAPS.md). No real credentials
# belong in this file; every value here is a placeholder.
###############################################################################

NODE_ENV=development

###############################################################################
# Storage
###############################################################################

# memory | postgres | supabase (packages/shared/src/config/StorageProviders.ts)
PARMANA_STORAGE=memory

# Required when PARMANA_STORAGE=postgres.
DATABASE_URL=

# Required when PARMANA_STORAGE=supabase. Also required in production
# (NODE_ENV != test) independent of PARMANA_STORAGE: the durable NonceStore
# and CallerAuditSink (packages/api/src/bootstrap/createNonceStore.ts,
# createCallerAuditSink.ts) require Supabase and fail closed at startup
# without it — see docs/VERIFICATION-GAPS.md G-13.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Opt-in required by tests/helpers/supabase-availability.ts before any
# Supabase-gated test suite is allowed to run against a live project — set
# alongside real SUPABASE_URL/key values to enable it. WARNING: running with
# this set executes suites against a real, live Supabase project and leaves
# permanent rows behind (e.g. consumed_nonces, caller_audit_events); do not
# set it for routine local `npm test` runs.
# ALLOW_LIVE_SUPABASE=1

###############################################################################
# Cryptography
###############################################################################

# single | hybrid | pq
# single: PRIMARY_SIGNATURE_PROVIDER alone signs/verifies everything
# (default, unchanged production behavior). hybrid: Execution Trust
# Records and Receipts (only -- see Hybrid Signature Support milestone,
# Phase A) are additionally signed by SECONDARY_SIGNATURE_PROVIDER, and
# verification requires both signatures to pass; every other signing
# surface (gateway attestation, execution authorization, connector
# signal-state verifiers, webhooks) is untouched by this setting. pq is
# reserved, not read by any call site today.
CRYPTO_MODE=single

# ed25519 | ecdsa-p256 | dilithium3 | dilithium5 | sphincs-plus
PRIMARY_SIGNATURE_PROVIDER=ed25519

# Required when CRYPTO_MODE=hybrid (e.g. "dilithium3"); must differ from
# PRIMARY_SIGNATURE_PROVIDER. Its key material must exist at
# <PARMANA_KEY_DIR>/default-secondary.{private,public}.pem -- generate
# with `npm run generate:hybrid-secondary-key`. Fails closed at first
# hybrid sign/verify if unset or the key files are missing.
SECONDARY_SIGNATURE_PROVIDER=

# sha256 | sha3-512 | blake3
HASH_PROVIDER=sha256

###############################################################################
# Key Management
###############################################################################

# local | aws-kms | azure-key-vault | gcp-kms | hsm
KEY_PROVIDER=local

# Directory containing the Ed25519/PQ key material (default.private.pem,
# default.public.pem, gateway.private.pem, gateway.public.pem, ...).
PARMANA_KEY_DIR=./keys

# Key id prefix used for the Gateway's attestation-signing keypair.
# Optional, defaults to "gateway".
PARMANA_GATEWAY_KEY_ID=gateway

###############################################################################
# Policy
###############################################################################

# Directory containing policy files (policies/<name>/<version>/policy.json).
# Required — the process refuses to start without it
# (packages/shared/src/config/Config.ts).
PARMANA_POLICY_DIR=./policies

###############################################################################
# Execution Authorization
###############################################################################

# TTL, in seconds, applied to a signed Execution Authorization when the
# caller does not specify one.
EXECUTION_AUTHORIZATION_TTL_SECONDS=120

###############################################################################
# Trust
###############################################################################

# v1
TRUST_PROFILE=v1

RECEIPT_VERSION=1

###############################################################################
# API
###############################################################################

PORT=3000

# Caller authentication. Fail-closed: refuses to start with no keys
# configured unless PARMANA_AUTH_DISABLED=true is set explicitly.
# JSON array of { "callerId": string, "keyHash": string (sha256 hex) }.
PARMANA_API_KEYS=[]

# Local development / tutorials only. Never set true in a real deployment.
PARMANA_AUTH_DISABLED=false

###############################################################################
# Connectors
###############################################################################

# Credential for the vendor-payment example connector
# (packages/api/src/bootstrap/createCredentialProvider.ts). Ignored when
# NODE_ENV=test (an in-memory static credential is used instead).
VENDOR_PAYMENT_TOKEN=replace-with-connector-token

# Razorpay test-mode key pair. Read directly (no intermediate bridge
# variable) by createRazorpayCredentialProvider.ts's NODE_ENV=test branch
# as the override for its built-in placeholder credential, and by
# tests/helpers/razorpay-live-availability.ts to gate
# packages/api/tests/integration/razorpay-live.integration.test.ts — the one
# test in this repo that calls Razorpay's real test-mode API instead of
# MockRazorpayServer. RAZORPAY_TEST_KEY_ID must start with "rzp_test_"; the
# live suite aborts hard, before any network call, if it does not. Unrelated
# to RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET (production credentials for
# createRazorpayCredentialProvider.ts).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Opt-in required alongside RAZORPAY_TEST_KEY_ID/RAZORPAY_TEST_KEY_SECRET
# before the live Razorpay test-mode suite is allowed to run — set alongside
# real test-mode key values to enable it. WARNING: running with this set
# makes real network calls to Razorpay's test-mode API; do not set it for
# routine local `npm test` runs.
# ALLOW_LIVE_RAZORPAY=1

# Third, independent gating tier on top of ALLOW_LIVE_RAZORPAY: a manually
# Checkout-captured Razorpay test-mode payment id, required only by the
# money-moving refund-creation cases in razorpay-live.integration.test.ts.
# Must start with "pay_"; the suite aborts hard, before any network call, if
# it does not. Absent, only those cases skip — the rest of the live suite
# still runs. See packages/api/README.md ("Third tier: live refund creation
# (money-moving)") for how to mint one; its refundable remainder depletes by
# 100 paise per suite run.
# TEST_RAZORPAY_CAPTURED_PAYMENT_ID=

# Razorpay webhook signature secret (POST /webhooks/razorpay). A third,
# independent Razorpay credential — same isolation rules as
# RAZORPAY_KEY_ID/SECRET above (never logged, never in errors/receipts).
# Fail-closed: unset in production (NODE_ENV != test), the webhook route is
# NOT registered at all (a request to it 404s), mirroring how the Razorpay
# connector itself is simply absent when RAZORPAY_KEY_ID/SECRET are unset.
RAZORPAY_WEBHOOK_SECRET=

# Test-mode override for the webhook secret above, read by
# resolveRazorpayWebhookSecret.ts's NODE_ENV=test branch. Falls back to a
# built-in placeholder if unset, so hermetic tests need zero setup — set
# this only if a test needs to sign requests with a caller-controlled
# secret. Unrelated to RAZORPAY_TEST_KEY_ID/SECRET (the outbound connector
# credential; this is inbound signature verification).
# RAZORPAY_TEST_WEBHOOK_SECRET=

# Poll interval (ms) for `npm run process:razorpay-settlements`
# (scripts/process-razorpay-settlements.ts), M4b's out-of-band settlement
# processor. Optional; defaults to 15000.
# RAZORPAY_SETTLEMENT_POLL_INTERVAL_MS=15000

###############################################################################
# HubSpot connector (@parmana/connector-hubspot) — dealstage/amount update
###############################################################################

# HubSpot Private App token used in production (NODE_ENV != test) by
# createHubSpotCredentialProvider.ts. If unset, the HubSpot connector is
# simply not registered at all (hubspot:deal-fetch / hubspot:deal-update
# have no connector to resolve to) — the rest of the API still starts
# normally, mirroring RAZORPAY_KEY_ID/SECRET's own fail-closed absence
# behavior.
HUBSPOT_PRIVATE_APP_TOKEN=

# HubSpot test-mode Private App token. Read directly (no intermediate
# bridge variable) by createHubSpotCredentialProvider.ts's NODE_ENV=test
# branch as the override for its built-in placeholder credential, and by
# tests/helpers/hubspot-live-availability.ts to gate
# packages/api/tests/integration/hubspot-live.integration.test.ts — the
# one test in this repo that calls HubSpot's real API instead of
# MockHubSpotServer. Must start with "pat-"; the live suite aborts hard,
# before any network call, if it does not. Unrelated to
# HUBSPOT_PRIVATE_APP_TOKEN (the production credential above). Create one
# from a free HubSpot developer/test account's Private Apps settings,
# scoped to crm.objects.deals.read/write only.
TEST_HUBSPOT_PRIVATE_APP_TOKEN=

# Opt-in required alongside TEST_HUBSPOT_PRIVATE_APP_TOKEN before the
# live HubSpot suite is allowed to run — set alongside a real test token
# to enable it. WARNING: running with this set makes real network calls
# to HubSpot's API and, if TEST_HUBSPOT_DEAL_ID is also set, mutates a
# real deal's amount (temporarily — the suite reverts it before it
# finishes). Do not set it for routine local `npm test` runs.
# ALLOW_LIVE_HUBSPOT=1

# Second, independent gating tier on top of ALLOW_LIVE_HUBSPOT: a real
# test deal id in the same HubSpot developer/test account, required only
# by the mutating deal-update case in hubspot-live.integration.test.ts.
# Absent, only that case skips — the rest of the live suite still runs.
# Unlike Razorpay's refund (irreversible; its remainder depletes per
# run), this case reads the deal's real amount, nudges it by a small
# within-threshold delta, verifies it live, then reverts it — safe to
# run repeatedly against the same deal.
# TEST_HUBSPOT_DEAL_ID=

# Base URL override for the HubSpot connector, read by
# createHubSpotConnector.ts. Test seam only: points the connector at a
# hermetic MockHubSpotServer instead of HubSpot's real API
# (https://api.hubapi.com). Never set in production.
# HUBSPOT_BASE_URL=

###############################################################################
# Logging
###############################################################################

# debug | info | warn | error
LOG_LEVEL=info

###############################################################################
# Retired — do not set
###############################################################################

# DATABASE_PROVIDER was replaced by PARMANA_STORAGE. Setting it causes
# startup to fail with an explicit error naming the replacement
# (packages/shared/src/config/ConfigValidation.ts).
